{
  "title": "Idea card (stored in M6)",
  "type": "object",
  "required": [
    "id",
    "name",
    "summary",
    "source",
    "url",
    "fetched_at",
    "text"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "problem": {
      "type": "string"
    },
    "customer": {
      "type": "string"
    },
    "niche_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stage": {
      "type": "string"
    },
    "funding_usd": {
      "type": [
        "number",
        "null"
      ]
    },
    "source": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "fetched_at": {
      "type": "string"
    },
    "text": {
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
