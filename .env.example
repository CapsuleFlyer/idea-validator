# Copy to .env and fill in. Never commit .env. Names only, no secrets, in this file.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ideas

# Keys for official APIs (leave empty until the scouts need them)
GITHUB_TOKEN=
PRODUCTHUNT_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Hosted model used as scorer fallback and for the ideator agents
HOSTED_MODEL_API_KEY=
